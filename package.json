{
  "name": "inbox-ledger",
  "private": true,
  "type": "module",
  "description": "A household ledger that fills itself from bank alert emails. Cloudflare Workers, D1 and Email Routing, on the free tier.",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply inbox-ledger --local",
    "db:migrate": "wrangler d1 migrations apply inbox-ledger --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "postal-mime": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20260918.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  },
  "license": "MIT",
  "author": "Thinh Nguyen (Danny)"
}
